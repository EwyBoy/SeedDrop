{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",

  "name": "${mod_name}",
  "description": "${description}",
  "authors": [
    "${mod_author}"
  ],
  "contact": {
    "homepage": "https://www.curseforge.com/minecraft/mc-mods/seed-drop",
    "sources": "https://github.com/EwyBoy/SeedDrop",
    "issues": "https://github.com/EwyBoy/SeedDrop/issues"
  },

  "license": "${license}",

  "environment": "*",
  "entrypoints": {
    "main": [
      "com.ewyboy.seeddrop.SeedDrop"
    ]
  },
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "fabric-api": "*",
    "minecraft": "${fabric_minecraft_version_range}",
    "java": ">=${java_version}"
  }
}
